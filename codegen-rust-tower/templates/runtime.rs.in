/// Append a single key/value pair to a query string buffer, percent-encoding
/// the value per RFC 3986. Used by `into_http_request` to assemble query
/// strings without dragging in the `url` crate's `Url::query_pairs_mut`
/// (which forces base-URL knowledge into the generated code).
pub fn push_query(buf: &mut String, key: &str, value: &str) {
    if !buf.is_empty() {
        buf.push('&');
    }
    encode_query_component(buf, key);
    buf.push('=');
    encode_query_component(buf, value);
}

fn encode_query_component(buf: &mut String, s: &str) {
    // Encode anything outside RFC 3986 unreserved + a small "safe in query"
    // allow-list. Conservative — over-encoding is fine.
    for b in s.bytes() {
        match b {
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'.' | b'_' | b'~' => {
                buf.push(b as char);
            }
            _ => buf.push_str(&format!("%{b:02X}")),
        }
    }
}
