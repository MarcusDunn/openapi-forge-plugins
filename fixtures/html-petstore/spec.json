{
  "openapi": "3.2.0",
  "info": {
    "title": "HTML Petstore",
    "version": "1.0.0",
    "summary": "Sample API for exercising generator-html-docs.",
    "description": "A small petstore-style spec that **exercises every documentation surface** the generator renders:\n\n- Nested tags (`tag.parent`)\n- Markdown in descriptions (this list, `inline code`, [links](https://example.com))\n- A deprecated endpoint with a prominent banner\n- Schemas with examples and properties\n",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "contact": {
      "name": "Pet Docs Team",
      "email": "pets@example.com",
      "url": "https://example.com/pets"
    }
  },
  "servers": [
    {
      "url": "https://{tenant}.api.example.com/v1",
      "description": "Production (per-tenant)",
      "variables": {
        "tenant": {
          "default": "acme",
          "description": "Customer tenant slug."
        }
      }
    },
    {
      "url": "https://staging.example.com/{stage}",
      "description": "Staging",
      "variables": {
        "stage": {
          "default": "v1",
          "enum": ["v1", "v1beta"],
          "description": "Staging API channel."
        }
      }
    }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "tags": [
    {
      "name": "pets",
      "summary": "Pet operations",
      "description": "Endpoints for **listing**, fetching, and managing pets. The two child tags split the operations by audience."
    },
    {
      "name": "pets-public",
      "parent": "pets",
      "summary": "Public-facing pet endpoints",
      "description": "Read-only endpoints available to any client. No auth required."
    },
    {
      "name": "pets-admin",
      "parent": "pets",
      "summary": "Administrative pet endpoints",
      "description": "Mutating endpoints that require staff credentials.\n\n> Calls here are audited."
    },
    {
      "name": "owners",
      "summary": "Owner directory",
      "description": "Top-level tag for pet-owner lookup."
    }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "tags": ["pets-public"],
        "summary": "List all pets",
        "description": "Returns every pet in the store. Pass `limit` to page.\n\nResults are sorted by `id` ascending.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of pets to return. Defaults to 20.",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "A paged array of pets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pets" }
              }
            }
          },
          "default": {
            "description": "Unexpected error.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "getPet",
        "tags": ["pets-public"],
        "summary": "Fetch a single pet",
        "description": "Look up a pet by its `petId`.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "Unique pet identifier.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The pet, if it exists.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "404": {
            "description": "No pet with this `petId`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "tags": ["pets-admin"],
        "security": [
          { "petsAdminOauth": ["pets:write"] }
        ],
        "summary": "Remove a pet",
        "description": "Removes the pet from the store. Audited.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "Pet to remove.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Deleted." },
          "404": {
            "description": "No pet with this id.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pets/admin/import": {
      "post": {
        "operationId": "importPets",
        "tags": ["pets-admin"],
        "summary": "Bulk-import pets",
        "description": "Accepts an array of `Pet` records and inserts them in one transaction.\n\nReturns `202` while the import runs asynchronously.",
        "requestBody": {
          "required": true,
          "description": "Pets to insert.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Pets" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Import accepted; check status separately.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImportJob" }
              }
            }
          }
        }
      }
    },
    "/tenants/{tenantId}/pets": {
      "get": {
        "operationId": "listTenantPets",
        "tags": ["pets-admin"],
        "security": [
          { "tenantOauth": ["openid", "roles"] }
        ],
        "summary": "List pets for a tenant",
        "description": "Tenant-scoped read. The Try-it form will RFC 8693-exchange your `tenantOauth` access token for an audience-scoped one (`urn:html-petstore:tenant:{tenantId}`) before sending.",
        "parameters": [
          {
            "name": "tenantId",
            "in": "path",
            "required": true,
            "description": "Tenant slug.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant's pets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pets" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}/events": {
      "get": {
        "operationId": "listPetEvents",
        "tags": ["pets-public"],
        "summary": "Stream events for a pet",
        "description": "Returns the event log for a pet — a discriminated union over event types.",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "description": "Pet whose events to fetch.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Event list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/PetEvent" }
                }
              }
            }
          }
        }
      }
    },
    "/pets/legacySearch": {
      "get": {
        "operationId": "legacySearchPets",
        "tags": ["pets-public"],
        "deprecated": true,
        "summary": "Search pets (deprecated)",
        "description": "Free-text search over names. **Deprecated** in favour of `listPets` with structured filters.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free-text query.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching pets.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pets" }
              }
            }
          }
        }
      }
    },
    "/owners": {
      "get": {
        "operationId": "listOwners",
        "tags": ["owners"],
        "summary": "List owners",
        "description": "Returns every registered owner.",
        "responses": {
          "200": {
            "description": "Owner list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Owner" }
                }
              }
            }
          }
        }
      }
    },
    "/owners/{ownerId}": {
      "get": {
        "operationId": "getOwner",
        "tags": ["owners"],
        "summary": "Fetch an owner",
        "parameters": [
          {
            "name": "ownerId",
            "in": "path",
            "required": true,
            "description": "Owner identifier.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The owner.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Owner" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "title": "Pet",
        "description": "A pet in the store.",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Server-assigned identifier."
          },
          "name": {
            "type": "string",
            "description": "Display name."
          },
          "tag": {
            "type": "string",
            "description": "Optional categorisation tag."
          }
        },
        "example": { "id": "pet_42", "name": "Whiskers", "tag": "cat" }
      },
      "Pets": {
        "type": "array",
        "title": "Pets",
        "description": "A page of pets.",
        "items": { "$ref": "#/components/schemas/Pet" }
      },
      "Owner": {
        "type": "object",
        "title": "Owner",
        "description": "A registered pet owner.",
        "required": ["id", "email"],
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "name": { "type": "string" }
        }
      },
      "ImportJob": {
        "type": "object",
        "title": "ImportJob",
        "description": "Status handle for an async bulk import.",
        "required": ["jobId", "status"],
        "properties": {
          "jobId": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["queued", "running", "succeeded", "failed"]
          }
        }
      },
      "Error": {
        "type": "object",
        "title": "Error",
        "description": "A problem details-style error payload.",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "message": { "type": "string" }
        }
      },
      "PetCreatedEvent": {
        "type": "object",
        "title": "PetCreatedEvent",
        "required": ["type", "petId", "at"],
        "properties": {
          "type": { "type": "string", "const": "created" },
          "petId": { "type": "string" },
          "at": { "type": "string", "format": "date-time" }
        }
      },
      "PetDeletedEvent": {
        "type": "object",
        "title": "PetDeletedEvent",
        "required": ["type", "petId", "at", "reason"],
        "properties": {
          "type": { "type": "string", "const": "deleted" },
          "petId": { "type": "string" },
          "at": { "type": "string", "format": "date-time" },
          "reason": { "type": "string" }
        }
      },
      "PetEvent": {
        "title": "PetEvent",
        "description": "An event in a pet's history. Discriminated by the `type` field.",
        "oneOf": [
          { "$ref": "#/components/schemas/PetCreatedEvent" },
          { "$ref": "#/components/schemas/PetDeletedEvent" }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "created": "#/components/schemas/PetCreatedEvent",
            "deleted": "#/components/schemas/PetDeletedEvent"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "API access tokens. Send `Authorization: Bearer <token>`."
      },
      "petsAdminOauth": {
        "type": "oauth2",
        "description": "OAuth 2.0 with the **client credentials** grant. Used for staff-only mutating endpoints.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.example.com/oauth/token",
            "scopes": {
              "pets:read": "Read pet records.",
              "pets:write": "Create, update, or delete pet records."
            }
          }
        }
      },
      "tenantOauth": {
        "type": "oauth2",
        "description": "OAuth 2.0 Authorization Code + PKCE against the platform IdP. The wire shape on the API is `Authorization: Bearer <jwt>`; this entry exists so OAuth-aware clients can run the auth flow themselves and so they can perform RFC 8693 token exchange to mint per-tenant resource-server tokens.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.example.com/oauth/authorize",
            "tokenUrl": "https://auth.example.com/oauth/token",
            "scopes": {
              "openid": "OIDC identity claims.",
              "roles": "Resource-access role mapping (so resource_access.<rs>.roles is populated)."
            }
          }
        },
        "x-token-exchange": {
          "audience-template": "urn:html-petstore:tenant:{tenantId}",
          "scope": ["roles"]
        }
      }
    }
  }
}
