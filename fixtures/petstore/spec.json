{
  "openapi": "3.0.3",
  "info": {
    "title": "Petstore",
    "version": "1.0.0",
    "description": "Petstore fixture exercising the rust-tower generator's codegen across enum styles, array query params, mixed response shapes, and content-type families."
  },
  "servers": [
    { "url": "https://petstore.example.com/v1" }
  ],
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "summary": "List all pets",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of pets",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pets" }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "tags": ["pets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Pet" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pets/findByTag": {
      "get": {
        "operationId": "findPetsByTag",
        "summary": "Filter pets by one or more tag values (array query param: bug #5).",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching pets",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pets" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "operationId": "showPetById",
        "summary": "Get a pet by id",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Expected response to a valid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replacePet",
        "summary": "Idempotent replace; both `400` and `4XX` declared (bug #3).",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Pet" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated pet",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pet" }
              }
            }
          },
          "400": {
            "description": "Specific 400 (must match before 4XX)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "4XX": {
            "description": "Other client errors",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "default": {
            "description": "Anything else",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pets/paginated": {
      "get": {
        "operationId": "listPaginatedPets",
        "summary": "Bug #21: cursor-paginated list. `x-pagination` declares the `nextPageToken` query-param ↔ `/nextPageToken` response-body cursor convention so the clap CLI emits `--pages N` / `--all-pages` flags. The tower client codegen is untouched.",
        "tags": ["pets"],
        "x-pagination": {
          "queryParam": "nextPageToken",
          "tokenPath": "/nextPageToken"
        },
        "parameters": [
          {
            "name": "nextPageToken",
            "in": "query",
            "required": false,
            "description": "Opaque cursor returned by the previous page; omit on the first call.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of pets plus an optional next-page cursor (null = last page).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PetsPage" }
              }
            }
          }
        }
      }
    },
    "/pets/nullability-demo": {
      "get": {
        "operationId": "getPetNullabilityDemo",
        "summary": "Bug #20: return a model that exercises every (required × nullable) cross-product so the optional+nullable case round-trips missing / explicit-null / value as distinct states.",
        "tags": ["pets"],
        "responses": {
          "200": {
            "description": "Showcase of every field-nullability shape",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NullabilityShowcase" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}/photo": {
      "get": {
        "operationId": "downloadPetPhoto",
        "summary": "Bug #19: binary-body response. The 2xx variant declares `image/png` (non-JSON), so the generator must emit `impl Operation` directly — *not* the JSON-only `JsonOperation` path — otherwise the blanket impl would still buffer-and-then-attempt-decode behavior in future work; today the streaming path leaves the body as a unit variant and doesn't try to decode.",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Raw PNG bytes",
            "content": {
              "image/png": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": {
            "description": "Pet not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}/problem": {
      "get": {
        "operationId": "getPetProblem",
        "summary": "Endpoint that responds with `application/problem+json` (bug #13).",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Problem response",
            "content": {
              "application/problem+json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string" },
          "tag": { "type": "string" },
          "status": { "$ref": "#/components/schemas/PetStatus" },
          "mood": { "$ref": "#/components/schemas/PetMood" }
        }
      },
      "Pets": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/Pet" }
      },
      "PetStatus": {
        "type": "string",
        "description": "Mixed-case enum values (bug #1).",
        "enum": ["available", "inProgress", "sold"]
      },
      "PetMood": {
        "type": "integer",
        "description": "Integer enum with a negative discriminant (bug #2).",
        "enum": [-1, 0, 1]
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "message": { "type": "string" }
        }
      },
      "PetsPage": {
        "type": "object",
        "description": "Bug #21 fixture: one page of pets plus the next-page cursor.",
        "required": ["pets"],
        "properties": {
          "pets":          { "$ref": "#/components/schemas/Pets" },
          "nextPageToken": { "type": "string", "nullable": true }
        }
      },
      "NullabilityShowcase": {
        "type": "object",
        "description": "Bug #20: every (required × nullable) cross-product. The optional+nullable field (`tristate`) needs `Option<Option<T>>` to keep missing distinguishable from explicit `null` on the wire.",
        "required": ["always_present", "nullable_required"],
        "properties": {
          "always_present":    { "type": "string" },
          "missing_allowed":   { "type": "string" },
          "nullable_required": { "type": "string", "nullable": true },
          "tristate":          { "type": "string", "nullable": true }
        }
      }
    }
  }
}
