{% extends "base.html.j2" %}
{% block content %}
<article aria-labelledby="op-title" data-operation-id="{{ op.id }}">
  <header>
    <h1 id="op-title">{{ op.summary if op.summary else op.id }}</h1>
    <p class="op-endpoint">
      <code class="method-badge {{ op.method_class }}" aria-label="HTTP method {{ op.method }}">{{ op.method }}</code>
      <code class="path">{% for seg in op.path_segments -%}
        {% if seg.is_param %}<span class="path-param">{{ seg.text }}</span>{% else %}{{ seg.text }}{% endif %}
      {%- endfor %}</code>
      <button
        type="button"
        class="copy-btn"
        data-copy-btn
        data-copy-endpoint="{{ op.path_template }}"
        aria-label="Copy endpoint URL">copy</button>
    </p>
    {% if op.tag_links %}
    <p class="op-tags">
      Tags:
      {% for t in op.tag_links %}
        <a href="{{ t.href|safe }}" rel="tag">{{ t.name }}</a>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
    {% endif %}
    <p role="status" class="deprecated-banner"{% if not op.deprecated %} hidden{% endif %}>
      <strong>Deprecated.</strong> This endpoint may be removed in a future version.
    </p>
  </header>

  {% if op.description_html %}
  <section aria-labelledby="description-heading">
    <h2 id="description-heading">Description</h2>
    {{ op.description_html|safe }}
  </section>
  {% endif %}

  {% set security = op.security %}
  {% include "partials/_auth_required.html.j2" %}

  {% if op.parameters %}
  <section aria-labelledby="parameters-heading">
    <h2 id="parameters-heading">Parameters</h2>
    {% set params = op.parameters %}
    {% include "partials/_params.html.j2" %}
  </section>
  {% endif %}

  {% if op.request_body %}
  <section aria-labelledby="request-body-heading">
    <h2 id="request-body-heading">Request body{% if op.request_body.required %} <small>(required)</small>{% endif %}</h2>
    {% if op.request_body.description_html %}{{ op.request_body.description_html|safe }}{% endif %}
    {% for c in op.request_body.content %}
    <article data-media-type="{{ c.media_type }}">
      <h3><code>{{ c.media_type }}</code></h3>
      <p>Type: {% set t = c.type %}{% include "partials/_typeref.html.j2" %}</p>
      {% set discriminator = c.discriminator %}
      {% include "partials/_discriminator.html.j2" %}
      {% if c.inline_type %}
      <details class="inline-nested">
        <summary>structure</summary>
        {% set inline = c.inline_type %}{% include "partials/_inline_schema.html.j2" %}
      </details>
      {% endif %}
      {% if c.example %}
        {% set example = c.example %}
        {% include "partials/_example.html.j2" %}
      {% endif %}
    </article>
    {% endfor %}
  </section>
  {% endif %}

  {% include "partials/_tryit.html.j2" %}

  <section aria-labelledby="responses-heading">
    <h2 id="responses-heading">Responses</h2>
    {% if op.responses %}
      {% for r in op.responses %}
      <article id="response-{{ r.status }}" data-status="{{ r.status }}" class="response">
        <h3>
          <code class="status-badge {{ r.status_class }}">{{ r.status }}</code>
          {% if r.summary %}{{ r.summary }}{% endif %}
        </h3>
        {% if r.description_html %}{{ r.description_html|safe }}{% endif %}
        {% if r.headers %}
        <section aria-labelledby="resp-{{ r.status }}-headers">
          <h4 id="resp-{{ r.status }}-headers">Headers</h4>
          <dl class="headers">
            {% for h in r.headers %}
            <dt>
              <code>{{ h.name }}</code>
              <small>({% if h.required %}required{% else %}optional{% endif %}{% if h.deprecated %}, deprecated{% endif %})</small>
              {% set t = h.type %}{% include "partials/_typeref.html.j2" %}
            </dt>
            <dd>
              {% if h.description_html %}{{ h.description_html|safe }}{% endif %}
              {% if h.inline_type %}
              <details class="inline-nested">
                <summary>structure</summary>
                {% set inline = h.inline_type %}{% include "partials/_inline_schema.html.j2" %}
              </details>
              {% endif %}
            </dd>
            {% endfor %}
          </dl>
        </section>
        {% endif %}
        {% if r.content %}
        <section aria-labelledby="resp-{{ r.status }}-content">
          <h4 id="resp-{{ r.status }}-content">Content</h4>
          {% for c in r.content %}
          <article data-media-type="{{ c.media_type }}">
            <h5><code>{{ c.media_type }}</code></h5>
            <p>Type: {% set t = c.type %}{% include "partials/_typeref.html.j2" %}</p>
            {% set discriminator = c.discriminator %}
            {% include "partials/_discriminator.html.j2" %}
            {% if c.inline_type %}
            <details class="inline-nested">
              <summary>structure</summary>
              {% set inline = c.inline_type %}{% include "partials/_inline_schema.html.j2" %}
            </details>
            {% endif %}
            {% if c.example %}
              {% set example = c.example %}
              {% include "partials/_example.html.j2" %}
            {% endif %}
          </article>
          {% endfor %}
        </section>
        {% endif %}
      </article>
      {% endfor %}
    {% else %}
      <p><em>No responses documented.</em></p>
    {% endif %}
  </section>

  {% if op.external_docs %}
  <footer>
    <p><a href="{{ op.external_docs.url }}">
      {{ op.external_docs.description if op.external_docs.description else "External documentation" }}
    </a></p>
  </footer>
  {% endif %}
</article>
{% endblock %}
